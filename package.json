{
  "name": "turfops-underwriting",
  "version": "0.1.0",
  "private": true,
  "description": "Commercial robotic mowing site evaluation and underwriting platform (MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:pages": "BASE_PATH=/CLA next build",
    "serve": "npx --yes serve out -l 3100",
    "start": "npx --yes serve out -l 3000"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
